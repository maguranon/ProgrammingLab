import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

url = "https://raw.githubusercontent.com/mwaskom/seaborn-data/master/iris.csv"
df = pd.read_csv(url)
df.head()

print(df.head())
print(df.info())
print("\nDistribuzione delle specie:")
print(df["species"].value_counts())

df["species"].value_counts().plot(kind="bar")
plt.xlabel("Specie")
plt.label("Numero di campioni")
plt.title("Distribuzione delle specie")
plt.show()

print("\nDimensioni medie dei petali:")
media = df.groupby("species")[["petal_length", "petal_width"]].mean()
print(medie)

sns.scatterplot(
data=df,
x="petal_length",
y="petal_width",
hue="species"
)

plt.xlabel("Lunghezza del petalo")
plt.label("Larghezza del petalo")
plt.title("Dimensioni dei petali per specie")
plt.show()

df["petal_area"] =  df["petal_length"] * df["petal_width"]
print("\nArea media del petalo per specie:")
print(df.groupby("species")["petal_area"].mean)

sns.boxplot(
data=df, 
x="species",
y="petal_area"
)

plt.xlabel("Specie")
plt.label("Area del petalo")
plt.title("Distribuzione dell'area del petalo per specie")
plt.show()
